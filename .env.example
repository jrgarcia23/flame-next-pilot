# Flame Analytics — variables necesarias para el sistema de leads + back office
# Copiar a .env.local para dev. En producción configurar en Vercel > Settings > Environment Variables.

# ============================================================
# Supabase (proyecto flame-leads)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # ¡SECRETO! No exponer en cliente.

# ============================================================
# Back office /admin
# ============================================================
# Lista de emails autorizados a entrar (separados por coma)
ADMIN_ALLOWED_EMAILS=jrgarcia@flameanalytics.com,jrgarcia@esconzeta.com

# Secreto HMAC para firmar el captcha del login (>= 24 chars)
# Generar con: openssl rand -base64 32
ADMIN_CAPTCHA_SECRET=cambia-esto-por-string-aleatorio-de-32-chars-minimo

# ============================================================
# Resend (email transaccional)
# ============================================================
RESEND_API_KEY=re_...
LEAD_FROM_EMAIL=Flame Analytics <leads@flameanalytics.com>
LEAD_NOTIFY_EMAIL=jrgarcia@flameanalytics.com

# ============================================================
# Site
# ============================================================
NEXT_PUBLIC_SITE_URL=https://flame-next.vercel.app
